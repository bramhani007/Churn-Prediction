# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
PORT=3000

# SQLite Database Path (use persistent disk path on Render if available, e.g. /var/data/churn.db)
DATABASE_PATH=database/churn.db

# Machine Learning Artifacts
MODEL_PATH=models/churn_pipeline.joblib
METRICS_PATH=models/model_metrics.json

# Risk Thresholds for Churn Probability
RISK_THRESHOLD_LOW=0.35
RISK_THRESHOLD_HIGH=0.65
